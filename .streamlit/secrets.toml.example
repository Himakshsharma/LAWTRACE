# Copy to .streamlit/secrets.toml locally, or paste into Streamlit Cloud → App → Settings → Secrets.
# Without a key, LAWTRACE still works in offline mode (grounded extracts, English answers).
GEMINI_API_KEY = "your-key-from-aistudio.google.com"
GEMINI_MODEL = "gemini-2.5-flash"
# LLM_PROVIDER = "ollama"     # to use a local model instead
# OLLAMA_MODEL = "llama3.1"
